<resources>
  <layout id="WatchFace">
    <drawable id="BackgroundDark" visible="true" />
    <drawable id="BackgroundLight" visible="false" />
    <drawable id="DateValueGraph" class="Shared.Graph">
      <param name="x">0</param>
      <param name="y">220</param>
      <param name="width">448</param>
      <param name="height">180</param>
      <param name="minMaxYOffset">-40</param>
    </drawable>
    <label id="DateLabel" x="center" y="5" font="Graphics.FONT_SYSTEM_SMALL" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
    <drawable id="Time" class="Time">
      <param name="locX">340</param>
      <param name="locY">50</param>
      <param name="hourMinuteSpace">3</param>
      <param name="hourFont">Graphics.FONT_NUMBER_THAI_HOT</param>
      <param name="minuteFont">Graphics.FONT_NUMBER_MILD</param>
      <param name="addMinuteY">-1</param>
    </drawable>
    <label id="GlucoseLabel" x="center" y="410" font="Graphics.FONT_LARGE" justification="Graphics.TEXT_JUSTIFY_CENTER" color="Graphics.COLOR_WHITE" />
    <label id="Data1Label" x="130" y="95" font="Graphics.FONT_SYSTEM_TINY" justification="Graphics.TEXT_JUSTIFY_RIGHT" color="Graphics.COLOR_WHITE" />
    <label id="Data2Label" x="130" y="140" font="Graphics.FONT_SYSTEM_XTINY" justification="Graphics.TEXT_JUSTIFY_RIGHT" color="Graphics.COLOR_WHITE" />
    <label id="Data3Label" x="130" y="170" font="Graphics.FONT_SYSTEM_XTINY" justification="Graphics.TEXT_JUSTIFY_RIGHT" color="Graphics.COLOR_WHITE" />
    <label id="Data4Label" x="130" y="200" font="Graphics.FONT_SYSTEM_XTINY" justification="Graphics.TEXT_JUSTIFY_RIGHT" color="Graphics.COLOR_WHITE" />

    <label id="MessageLabel" x="20" y="260" font="Graphics.FONT_SYSTEM_XTINY" justification="Graphics.TEXT_JUSTIFY_LEFT" color="Graphics.COLOR_RED" />
  </layout>
</resources>
